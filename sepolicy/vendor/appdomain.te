allowxperm appdomain gpu_device:chr_file ioctl { 0x8000-0x8001 0x8003 0x8005-0x8007 0x800c-0x8011 0x8014-0x8019 0x801b 0x801d-0x801f 0x8024-0x8029 0x802b-0x8037 0x803a-0x803f 0x8043 };

neverallow appdomain edgetpu_device:chr_file open;
