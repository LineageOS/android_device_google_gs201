        <item>Potrdilo je poteklo</item>
        <item>Tipalo je začasno onemogočeno</item>
        <item>Napaka pri umerjanju</item>
        <item>Odklepanje z obrazom ni na voljo. Telefon je prevroč.</item>
        <item>Odklepanje z obrazom je treba znova nastaviti</item>
        <item>Prilagodite osvetlitev in držite pri miru</item>
    </string-array>
</resources>
