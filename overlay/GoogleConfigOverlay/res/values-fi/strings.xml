        <item>Kalibrointivirhe</item>
        <item>Kasvojentunnistusavaus ei käytettävissä. Puhelin on liian kuuma.</item>
        <item>Kasvojentunnistusavaus on otettava käyttöön uudelleen</item>
        <item>Säädä valaistusta ja pidä laite paikallaan</item>
    </string-array>
