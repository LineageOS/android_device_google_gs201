    <!-- Introduction description message shown in fingerprint enrollment introduction screen in setup wizard. [CHAR LIMIT=NONE]-->
    <string name="security_settings_fingerprint_v2_enroll_introduction_footer_message_2">Funkcja odblokowywania odciskiem palca tworzy unikalny model odcisku, który pozwala zweryfikować Twoją tożsamość. Aby taki model mógł powstać, musisz zapisać kilka obrazów odcisku palca w różnej pozycji.</string>

    <!-- Introduction title shown in fingerprint enrollment dialog to locate the sensor [CHAR LIMIT=29] -->
